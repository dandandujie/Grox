{
  "name": "grox",
  "private": true,
  "type": "module",
  "description": "A local-first personal agent workspace for the desktop.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/with-go.mjs mygo dev",
    "build": "node scripts/with-go.mjs mygo build",
    "generate": "node scripts/with-go.mjs mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:go": "node scripts/with-go.mjs go test ./...",
    "verify": "npm run typecheck && node scripts/with-go.mjs go test ./... && node scripts/with-go.mjs go vet ./..."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.70.0",
    "mygo-runtime": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "mygo-cli": "^0.8.3",
    "typescript": "^7",
    "vite": "^8"
  },
  "homepage": "https://github.com/dandandujie/Grox",
  "repository": {
    "type": "git",
    "url": "https://github.com/dandandujie/Grox.git"
  },
  "bugs": {
    "url": "https://github.com/dandandujie/Grox/issues"
  },
  "author": "Grox contributors"
}
